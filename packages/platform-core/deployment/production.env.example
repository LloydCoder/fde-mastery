# Production configuration — inject from your secret manager, never commit real values.
FDE_ENVIRONMENT=production
FDE_STORAGE_BACKEND=postgres
FDE_RATE_LIMIT_BACKEND=redis
FDE_DATABASE_URL=postgresql+psycopg://<managed-db-user>:<password>@<managed-postgres-host>:5432/<database>
FDE_REDIS_URL=rediss://:<password>@<managed-redis-host>:6379/0

# OIDC provider (issuer must expose .well-known/openid-configuration)
FDE_OIDC_ISSUER=https://<identity-provider-domain>/<tenant>
FDE_OIDC_AUDIENCE=fde-mastery-platform
FDE_OIDC_JWKS_URL=
FDE_OIDC_ALGORITHMS=RS256

# Observability: point the SDK at a private OTLP Collector endpoint.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=fde-mastery-platform
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://<otel-collector>/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://<otel-collector>/v1/metrics

MOCK_LLM=false
FDE_API_KEYS=
FDE_ADMIN_API_KEYS=
