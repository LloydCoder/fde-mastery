# Application API keys (comma-separated). Never commit real keys.
FDE_API_KEYS=replace-with-application-key

# Dedicated administrator keys (comma-separated). Never reuse application keys.
FDE_ADMIN_API_KEYS=replace-with-admin-key

# Storage: memory for local/tests, postgres for durable deployments.
FDE_STORAGE_BACKEND=memory
FDE_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fde_mastery
FDE_DB_CREATE_TABLES=false

# Rate limiting: memory is process-local; Redis is for horizontally scaled deployments.
FDE_RATE_LIMIT_BACKEND=memory
FDE_REDIS_URL=redis://localhost:6379/0
FDE_RATE_LIMIT_WINDOW_SECONDS=60
FDE_RATE_LIMIT_REQUESTS=60

# Maximum accepted request body size.
FDE_MAX_BODY_BYTES=262144
